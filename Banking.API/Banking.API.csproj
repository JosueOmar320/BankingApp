<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- XML docs feed the Swagger UI (endpoint descriptions). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- English texts live in the main assembly; Spanish ones in the es/ satellite assembly. -->
    <NeutralLanguage>en</NeutralLanguage>
    <UserSecretsId>banking-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Banking.Application\Banking.Application.csproj" />
    <ProjectReference Include="..\Banking.Infrastructure\Banking.Infrastructure.csproj" />
  </ItemGroup>

</Project>
