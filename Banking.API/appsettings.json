{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "IncludeScopes": true
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=../Banking.Infrastructure/Data/banking.db"
  },
  "Jwt": {
    "Issuer": "BankingApp",
    "Audience": "BankingApp.API",
    "AccessTokenLifetimeMinutes": 60
  },
  "RateLimiting": {
    "Authentication": { "PermitLimit": 10, "WindowSeconds": 60 },
    "MoneyOperations": { "PermitLimit": 30, "WindowSeconds": 60 }
  }
}
